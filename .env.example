# Runtime secrets: generate ADMIN_TOKEN using npm run token. Never commit real values.
GEMINI_API_KEY=
ADMIN_TOKEN=
# Select a model enabled for this API project. Verify with npm run check:gemini.
GEMINI_MODEL=gemini-3.5-flash-lite
# Start empty, pair, copy group IDs from the protected dashboard, then restart.
ALLOWED_GROUP_IDS=
# Exact sender IDs: 2341234567890@c.us or the sender's @lid ID.
# The linked WhatsApp account can always issue commands in enabled groups.
ALLOWED_SENDER_IDS=
ALLOW_MEMBER_COMMANDS=false
RECORD_OWN_MESSAGES=true
DATA_DIR=./data
PORT=3000
HOST=0.0.0.0
MAX_SUMMARY_MESSAGES=200
MAX_INPUT_CHARS=60000
MAX_MESSAGE_CHARS=4000
MAX_PENDING_PER_GROUP=5000
RETENTION_DAYS=7
SUMMARY_COOLDOWN_SECONDS=60
MAX_CONCURRENT_SUMMARIES=2
AI_TIMEOUT_SECONDS=90
MAX_RECONNECT_ATTEMPTS=10
# Local browser path only. Docker sets its own path to Debian Chromium.
PUPPETEER_EXECUTABLE_PATH=
CHROMIUM_NO_SANDBOX=false
QR_IN_TERMINAL=false
